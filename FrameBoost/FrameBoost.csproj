<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\branding\cloudframe-icon.ico</ApplicationIcon>
    <AssemblyName>CloudFrame</AssemblyName>
    <Product>CloudFrame</Product>
    <Title>CloudFrame</Title>
    <Description>CloudFrame is a safe, modern Windows game-session optimizer by Cloud.</Description>
    <Company>Cloud</Company>
    <Authors>Cloud</Authors>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <InformationalVersion>1.0.2</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\assets\branding\chibi-cloud-watermark.png" LogicalName="CloudFrame.Assets.Branding.ChibiCloudWatermark.png" />
    <Content Include="ThirdParty\PresentMon\PresentMon-2.4.1-x64.exe">
      <Link>tools\PresentMon\PresentMon-2.4.1-x64.exe</Link>
      <TargetPath>tools\PresentMon\PresentMon-2.4.1-x64.exe</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyPresentMon" AfterTargets="Build">
    <MakeDir Directories="$(OutputPath)tools\PresentMon" />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\ThirdParty\PresentMon\PresentMon-2.4.1-x64.exe"
      DestinationFolder="$(OutputPath)tools\PresentMon"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StageCleanReleaseLayout" AfterTargets="Publish" Condition="'$(SkipCleanReleaseStage)' != 'true'">
    <PropertyGroup>
      <CleanReleaseRoot>$(MSBuildProjectDirectory)\..\dist\CloudFrame</CleanReleaseRoot>
      <CleanReleaseToolsDir>$(CleanReleaseRoot)\tools\PresentMon</CleanReleaseToolsDir>
      <CleanReleaseSymbolsDir>$(CleanReleaseRoot)\symbols</CleanReleaseSymbolsDir>
      <CleanReleaseSupportDir>$(CleanReleaseRoot)\support</CleanReleaseSupportDir>
    </PropertyGroup>

    <RemoveDir Directories="$(CleanReleaseRoot)" Condition="Exists('$(CleanReleaseRoot)')" />
    <MakeDir Directories="$(CleanReleaseRoot);$(CleanReleaseToolsDir);$(CleanReleaseSymbolsDir)" />

    <ItemGroup>
      <CleanReleasePrimaryExe Include="$(PublishDir)CloudFrame.exe" Condition="Exists('$(PublishDir)CloudFrame.exe')" />
      <CleanReleaseToolFiles Include="$(MSBuildProjectDirectory)\ThirdParty\PresentMon\PresentMon-2.4.1-x64.exe" />
      <CleanReleaseSymbolFiles Include="$(PublishDir)*.pdb" />
      <CleanReleaseSupportFiles Include="$(PublishDir)**\*.*"
                                Exclude="$(PublishDir)CloudFrame.exe;$(PublishDir)*.pdb;$(PublishDir)tools\PresentMon\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(CleanReleasePrimaryExe)" DestinationFolder="$(CleanReleaseRoot)" SkipUnchangedFiles="true" Condition="'@(CleanReleasePrimaryExe)' != ''" />
    <Copy SourceFiles="@(CleanReleaseToolFiles)"
          DestinationFiles="@(CleanReleaseToolFiles->'$(CleanReleaseToolsDir)\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(CleanReleaseToolFiles)' != ''" />
    <Copy SourceFiles="@(CleanReleaseSymbolFiles)" DestinationFolder="$(CleanReleaseSymbolsDir)" SkipUnchangedFiles="true" Condition="'@(CleanReleaseSymbolFiles)' != ''" />
    <MakeDir Directories="$(CleanReleaseSupportDir)" Condition="'@(CleanReleaseSupportFiles)' != ''" />
    <Copy SourceFiles="@(CleanReleaseSupportFiles)"
          DestinationFiles="@(CleanReleaseSupportFiles->'$(CleanReleaseSupportDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(CleanReleaseSupportFiles)' != ''" />

    <WriteLinesToFile
      File="$(CleanReleaseRoot)\README.txt"
      Overwrite="true"
      Lines="CloudFrame 1.0.2 clean release layout%0D%0A%0D%0ACloudFrame.exe - launch this%0D%0AREADME.txt - quick package guide%0D%0Atools\\PresentMon\\PresentMon-2.4.1-x64.exe - FPS capture helper used by the overlay%0D%0Asymbols\\CloudFrame.pdb - debug symbols%0D%0Asupport\\ - extra runtime support files if the publish output needs them" />
  </Target>

</Project>
